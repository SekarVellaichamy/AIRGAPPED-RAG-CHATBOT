# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=chatbot
DATABASE_URL=postgresql://postgres:password@db:5432/chatbot

# Server Configuration (HTTPS)
BASE_URL=https://chat.afro.iaf.in
SSL_ENABLED=True
SSL_CERTFILE=ssl/cert.pem
SSL_KEYFILE=ssl/key.pem
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Security Configuration (REQUIRED)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_32
DEBUG=False  # Enable /docs and /redoc endpoints
SECURE_COOKIES=True  # Set to True with HTTPS enabled

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=llama3
# LLM_TIMEOUT=60.0

# RAG Configuration
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=5

# OCR Configuration
OCR_ENABLED=True

# Logging Configuration
LOG_LEVEL=INFO
LOG_TO_FILE=False
LOG_FILE_PATH=app.log

# LDAP Authentication (Optional)
# Set LDAP_ENABLED=True to enable LDAP authentication
LDAP_ENABLED=False
LDAP_SERVER=ldap.example.com
LDAP_PORT=389
LDAP_USE_SSL=False
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_START_TLS=False
LDAP_SKIP_CERTIFICATE_VERIFY=False
